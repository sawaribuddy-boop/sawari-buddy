# Copy to .env.local (never commit real values).
# Values for local development are printed by `pnpm db:start` / `supabase status`.

# --- Mobile (public by design: bundled into the app) ---
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Admin web (public by design: bundled into the browser) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (admin server actions / Edge Functions). NEVER prefix with EXPO_PUBLIC_ or NEXT_PUBLIC_. ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Tests: direct Postgres connection to the LOCAL database only ---
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# --- Driver simulator (scripts/dev/simulate-driver.ts) ---
SIM_DRIVER_EMAIL=
SIM_DRIVER_PASSWORD=
