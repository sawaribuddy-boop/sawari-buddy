# Copy to .env.local, or generate it for your current Wi-Fi with: pnpm mobile:env
# PUBLIC values only: these are bundled into the app. NEVER put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=http://<your-mac-lan-ip>:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key from `pnpm exec supabase status`>
